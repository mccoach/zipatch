# ============================================================
# Zipatch .gitignore
# Python desktop utility project
# ============================================================


# ============================================================
# 1. Python cache / compiled bytecode
# ============================================================

__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd


# ============================================================
# 2. Virtual environments
# ============================================================

.venv/
venv/
env/
ENV/
virtualenv/
.conda/


# ============================================================
# 3. Python packaging / build artifacts
# ============================================================

build/
dist/
downloads/
develop-eggs/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
pip-wheel-metadata/

*.egg-info/
.installed.cfg
*.egg
MANIFEST


# ============================================================
# 4. PyInstaller artifacts
# ============================================================

*.spec
*.manifest
*.toc
*.pkg
*.pyz
*.pyzw


# ============================================================
# 5. Test / coverage artifacts
# ============================================================

.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
junit.xml
test-results/


# ============================================================
# 6. Linter / formatter / type-check caches
# ============================================================

.cache/
.mypy_cache/
.pyre/
.pytype/
.pyright/
.ruff_cache/
.dmypy.json
dmypy.json


# ============================================================
# 7. IDE / editor files
# ============================================================

.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
.vim/


# ============================================================
# 8. OS-generated files
# ============================================================

.DS_Store
.AppleDouble
.LSOverride
._*

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/


# ============================================================
# 9. Logs / temporary runtime output
# ============================================================

logs/
log/
tmp/
temp/

*.log
*.out
*.err
*.trace
*.tmp
*.temp


# ============================================================
# 10. Local configuration / secrets
# ============================================================

.env
.env.*
*.env
*.local
*.secret

secrets.json
secret.json
credentials.json
token.json

# Local Python version selection
.python-version


# ============================================================
# 11. Zipatch local application data
# ============================================================

# 保存本机路径、历史输入、收藏、修改包内容和执行结果，
# 属于用户本地数据，不应提交到仓库。
zipatch_config.json

# 如以后添加可共享的配置模板，应允许提交。
!zipatch_config.example.json


# ============================================================
# 12. Backup / recovery files
# ============================================================

*.bak
*.bak1
*.bak2
*.backup
*.orig
*.old

backup/
backups/


# ============================================================
# 13. Databases / local storage
# ============================================================

*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal


# ============================================================
# 14. Archives / compressed files
# ============================================================

*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.gz


# ============================================================
# 15. Installer / binary outputs
# ============================================================

*.exe
*.msi
*.dmg
*.app
*.AppImage


# ============================================================
# 16. Notebook artifacts
# ============================================================

.ipynb_checkpoints/


# ============================================================
# 17. Keep project source and resources
# ============================================================

# Explicitly keep source files
!*.py

# Explicitly keep requirements
!requirements.txt

# Explicitly keep assets
!assets/
!assets/*.ico
!assets/*.svg
!assets/*.png
wechat_qr.png

# Zipatch 自动生成的修改包备份和本地归档
99_归档/
