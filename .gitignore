# ============================================================
# Zipatch .gitignore
# Python desktop utility project
# ============================================================


# ============================================================
# 1. Python cache / compiled bytecode
# ============================================================

__pycache__/
*.py[cod]
*$py.class

# 不全局忽略 *.pyd：
# 虚拟环境中的扩展由环境目录规则覆盖，
# 项目以后可能需要提交正式的二进制扩展。


# ============================================================
# 2. Virtual environments
# ============================================================

/.venv*/
venv/
env/
ENV/
virtualenv/
.conda/
__pypackages__/


# ============================================================
# 3. Python packaging / build artifacts
# ============================================================

/build/
/dist/
/downloads/
/develop-eggs/
/eggs/
/.eggs/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
/pip-wheel-metadata/

*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 建议不默认忽略 downloads/、parts/、var/ 和 MANIFEST，
# 避免误伤项目数据或正式打包文件。


# ============================================================
# 4. PyInstaller artifacts
# ============================================================

*.spec
*.manifest
*.toc
*.pkg
*.pyz
*.pyzw

/.pack-build/
/.pack-spec/

# 常规产物已由 /build/、/dist/ 覆盖。
# 建议不全局忽略 *.spec、*.manifest、*.pkg 等：
# 它们可能是正式构建配置、Windows 清单或测试样本。



# ============================================================
# 5. Test / coverage artifacts
# ============================================================

.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
junit.xml
/test-results/
/tests/results/

# 保留 tests/ 下的测试源码及正式测试样本。


# ============================================================
# 6. Linter / formatter / type-check caches
# ============================================================

.cache/
.mypy_cache/
.pyre/
.pytype/
.pyright/
.ruff_cache/
.dmypy.json
dmypy.json


# ============================================================
# 7. IDE / editor files
# ============================================================

/.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj

*.user
*.userosscache
*.sln.docstates
*.sln
*.swp
*.swo
*~
.vim/


# ============================================================
# 8. OS-generated files
# ============================================================

.DS_Store
.AppleDouble
.LSOverride
._*

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/


# ============================================================
# 9. Logs / temporary runtime output
# ============================================================

/logs/
/log/
/tmp/
/temp/

*.log
*.out
*.err
*.trace
*.tmp
*.temp

# 建议不全局忽略 *.out、*.err、*.trace，
# 避免误伤正式测试预期结果与诊断样本。


# ============================================================
# 10. Local configuration / secrets
# ============================================================

.env
.env.*
*.env
*.local
*.secret

!.env.example
!.env.sample
!.env.template

secrets.json
secret.json
credentials.json
token.json

# Local Python version selection
.python-version

# .python-version 可用于共享 Python 版本选择，
# 建议不默认忽略。


# ============================================================
# 11. Zipatch local application data
# ============================================================

# 保存本机路径、历史输入、收藏、修改包内容和执行结果，
# 属于用户本地数据，不应提交到仓库。
zipatch_config.json

# 如以后添加可共享的配置模板，应允许提交。
!zipatch_config.example.json


# ============================================================
# 12. Backup / recovery files
# ============================================================

*.bak
*.bak[0-9]*
*.backup
*.orig
*.old
*.rej

/backup/
/backups/

# Zipatch 自动生成的修改备份，任意层级均忽略。
AI文件修改备份/

# 当前项目的本地历史归档。
/99_归档/


# ============================================================
# 13. Databases / local storage
# ============================================================

*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal

# 建议不按扩展名全局忽略数据库，
# 避免误伤以后需要提交的测试数据库或正式资源。
# 新增本地数据库后，应按具体路径添加忽略规则。

# ============================================================
# 14. Archives / compressed files
# ============================================================

*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.gz

# 建议不全局忽略压缩文件，
# 避免误伤正式测试样本、资源包和离线依赖。
# 构建及备份目录已有对应忽略规则。

# ============================================================
# 15. Installer / binary outputs
# ============================================================

*.exe
*.msi
*.dmg
*.app
*.AppImage

# 当前 EXE 及其他发布产物由 /dist/ 覆盖。
# 建议不全局忽略 *.exe、*.msi 等，
# 避免误伤以后需要提交的工具或正式资源。


# ============================================================
# 16. Notebook artifacts
# ============================================================

.ipynb_checkpoints/


# ============================================================
# 17. Keep project source and resources
# ============================================================

# Explicitly keep source files
!*.py

# Explicitly keep requirements
!requirements.txt

# Explicitly keep assets
!assets/
!assets/*.ico
!assets/*.svg
!assets/*.png
!wechat_qr.png
